{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DalyWave",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#08090c",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 26 },
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/DalyWave.icon"
    ],
    "externalBin": [
      "../../services/fetcher/dist/sidecar/dalywave-fetcher",
      "../../services/fetcher/dist/sidecar/deno",
      "../../services/fetcher/dist/sidecar/ffmpeg",
      "../../services/fetcher/dist/sidecar/ffprobe",
      "../../services/fetcher/dist/sidecar/fpcalc"
    ],
    "resources": {
      "../../services/fetcher/dist/sidecar/resources/bgutil-server/": "bgutil-server/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
