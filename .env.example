# Настройки DalyWave. Скопируй в .env (локально — в корне репозитория, на сервере — ~/dalywave/.env, права 600).
# Пустая переменная равна отсутствующей. Значения ниже — для локальной разработки, секретов здесь нет.

# ─── Сервер ───
# Postgres. Локально его поднимает `make up`
DALYWAVE_DATABASE_URL=postgres://dalywave:dalywave@localhost:5400/dalywave
# Публичный адрес сайта, без / в конце. Из него берутся адрес возврата OIDC
# (<PUBLIC_URL>/api/auth/oidc/callback), разрешённый Origin и флаг Secure у cookie (только для https).
# Прод: https://wave.daly.rest
DALYWAVE_PUBLIC_URL=http://localhost:3400
# Ключ для шифрования cookie входа: 64 hex-символа, `openssl rand -hex 32`. Обязателен для https;
# локально без него берётся случайный ключ, и начатый вход не переживает перезапуск API.
DALYWAVE_SECRET_KEY=
# Где слушать API. По умолчанию 0.0.0.0:8400
DALYWAVE_LISTEN=0.0.0.0:8400
# Собранный интерфейс (папка .output/public Nuxt). Без неё API отдаёт только /api
DALYWAVE_STATIC_DIR=

# ─── Вход через daly.rest (OpenID Connect) ───
# Включается, только когда заданы все три; заданная часть без остальных — ошибка запуска.
# Клиент DalyWave: issuer https://daly.rest, client_id dalywave-37a20828, секрет — из админки daly.rest.
# Адреса возврата там: https://wave.daly.rest/api/auth/oidc/callback и http://localhost:3400/api/auth/oidc/callback
DALYWAVE_OIDC_ISSUER=
DALYWAVE_OIDC_CLIENT_ID=
DALYWAVE_OIDC_CLIENT_SECRET=
# Подпись кнопки входа
DALYWAVE_OIDC_TITLE=daly.rest
# Роли daly.rest (через запятую), которые делают администратором DalyWave
DALYWAVE_OIDC_ADMIN_ROLES=admin
# Почты через запятую: получают роль admin при входе, если daly.rest подтвердил почту
DALYWAVE_ADMIN_EMAILS=
# Аварийный вход паролем (входит как владелец). Пусто или короче 32 символов — выключен.
# Сгенерировать: openssl rand -base64 33
DALYWAVE_ADMIN_PASSWORD=

# ─── Хранилище S3: обложки, аудио. Локально — SeaweedFS из `make up`, в проде — Cloudflare R2 ───
# Включается, только когда заданы адрес и оба ключа; без них файлы живут в памяти процесса (только разработка).
# Бакет создаётся сам, если его нет (локально). У R2 бакет заводится в панели, ключ ограничен этим бакетом.
# R2: https://<account_id>.r2.cloudflarestorage.com, регион auto
DALYWAVE_S3_ENDPOINT=http://localhost:8401
# Адрес для подписанных ссылок (аудио для плеера, загрузка от домашнего загрузчика), если клиенты видят
# хранилище по другому адресу, чем сервер (например, сервер ходит во внутренний адрес docker). Пусто — тот же
DALYWAVE_S3_PUBLIC_ENDPOINT=
DALYWAVE_S3_REGION=auto
DALYWAVE_S3_BUCKET=dalywave
DALYWAVE_S3_ACCESS_KEY_ID=dalywave
DALYWAVE_S3_SECRET_ACCESS_KEY=dalywave-local-secret

# ─── Deezer (каталог; ключ не нужен) ───
# Адрес API. Меняется только в тестах
DALYWAVE_DEEZER_URL=https://api.deezer.com
# Deezer пускает ~50 запросов за 5 секунд с одного адреса, а ходят к нему API, воркер и fetcher.
# Сколько запросов за 5 секунд позволено каждому процессу (1–40); сумма должна оставлять запас
DALYWAVE_DEEZER_RATE_API=25
DALYWAVE_DEEZER_RATE_WORKER=15

# ─── Скачивание аудио ───
# Задачу скачивания выполняет тот, кто её взял. Загрузчик на домашнем Mac (`make downloader`,
# токен dwk_… из админки) берёт задания через /api/fetcher/* всегда. Воркер качает сам через
# серверный fetcher, только если в режиме есть server: remote (по умолчанию) | remote,server.
# С сервера YouTube не отдаёт аудио (docs/decisions.md) — server включать с cookies запасного аккаунта
DALYWAVE_FETCHER_MODE=remote
# Серверный fetcher (в проде — http://fetcher:8402, профиль compose server-fetcher)
DALYWAVE_FETCHER_URL=http://localhost:8402

# ─── Сервисы (следующие этапы) ───
DALYWAVE_ML_URL=http://localhost:8403

# ─── Логи ───
# Фильтр tracing, например dalywave_server=debug,tower_http=info. Пусто — по умолчанию:
# у API dalywave_api=info,dalywave_server=info,tower_http=info, у воркера dalywave_worker=info,dalywave_server=info
DALYWAVE_LOG=
# pretty — читаемый вывод, json — строки JSON для сервера
DALYWAVE_LOG_FORMAT=pretty

# ─── Инструменты ───
# sqlx-cli и тесты (`cargo test`, `make sqlx-prepare`) читают DATABASE_URL без префикса
DATABASE_URL=postgres://dalywave:dalywave@localhost:5400/dalywave
