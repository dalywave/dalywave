# DalyWave settings for infra/selfhost/docker-compose.yml. Copy to .env next to the compose file,
# then `chmod 600 .env`. An empty value is the same as not set. Guide: docs/self-hosting/install.md

# ─── Required ───
# The address people open, without a trailing slash, exactly: scheme, host and port. Sign-in cookies,
# the Origin check and OIDC redirect URIs are built from it. http:// is fine at home
# (http://192.168.1.20:8400); on the internet use https:// behind a reverse proxy.
DALYWAVE_PUBLIC_URL=http://localhost:8400
# Encrypts sign-in cookies and signs file links: 64 hex characters, `openssl rand -hex 32`.
# Changing it signs everyone out and cancels file links already handed out.
DALYWAVE_SECRET_KEY=
# Database password, `openssl rand -hex 24` (letters and digits only: it becomes part of a URL)
POSTGRES_PASSWORD=
# Your music folder on this machine. Mounted read-only, never modified; files must be readable by
# uid 10001 (world-readable is enough). FLAC, MP3, AAC, ALAC, Vorbis, Opus, WAV, AIFF…
MUSIC_DIR=/srv/music

# ─── Containers ───
# Published port. 127.0.0.1:8400 — reachable only from a reverse proxy on this machine
HTTP_PORT=8400
# Image version: latest, or a release such as 0.1.19
IMAGE_TAG=latest
# Sound analysis service (ml): 1 — on, 0 — off for machines with less than ~3 GB of free memory.
# Without it the wave shuffles your library, DJ transitions and search by sound are unavailable
ML_REPLICAS=1
# Optional containers by profile: `downloader` (see "Downloader" below)
COMPOSE_PROFILES=

# ─── Server ───
# How the server introduces itself to the apps
DALYWAVE_SERVER_NAME=DalyWave
# Logs: json (default in the image) or pretty — easier to read in `docker compose logs`
DALYWAVE_LOG_FORMAT=pretty

# ─── Sign-in: docs/self-hosting/auth.md ───
# Local accounts (username and password, invites). While there are no users, the sign-in page offers
# to create the administrator — do it right after the first start
DALYWAVE_LOCAL_AUTH=true
# Emergency sign-in as the first administrator, when nothing else works. Empty or shorter than
# 32 characters — off. `openssl rand -base64 33`
DALYWAVE_ADMIN_PASSWORD=
# ONLY FOR A PUBLIC DEMO SERVER — leave it unset on your own server. Username of an existing local
# account that anyone can enter with the «Try the demo» button, no password. Its password, username,
# sign-ins, deletion and admin role are locked. Unset — no button
# DALYWAVE_DEMO_ACCOUNT=demo
# Comma-separated emails that always get the admin role (verified email from a trusted provider)
DALYWAVE_ADMIN_EMAILS=
# Any OpenID Connect provider, as many as you like: DALYWAVE_OIDC_<ID>_*. Redirect URI to register
# at the provider: <DALYWAVE_PUBLIC_URL>/api/auth/oidc/<id>/callback (POCKET_ID → pocket-id)
# DALYWAVE_OIDC_AUTHENTIK_ISSUER=https://auth.example.com/application/o/dalywave/
# DALYWAVE_OIDC_AUTHENTIK_CLIENT_ID=
# DALYWAVE_OIDC_AUTHENTIK_CLIENT_SECRET=
# DALYWAVE_OIDC_AUTHENTIK_NAME=Authentik
# DALYWAVE_OIDC_AUTHENTIK_ADMIN_CLAIM=groups
# DALYWAVE_OIDC_AUTHENTIK_ADMIN_VALUE=DalyWave Admins
# Also: _ICON, _SCOPES, _AUTO_REGISTER, _TRUST_EMAIL, _AUTH_METHOD. Button order:
# DALYWAVE_OIDC_PROVIDERS=authentik

# ─── Storage: docs/self-hosting/storage.md ───
# Here it is the `data` volume (fs). For Cloudflare R2, MinIO and other S3: DALYWAVE_STORAGE=s3 and
# DALYWAVE_S3_ENDPOINT, DALYWAVE_S3_REGION, DALYWAVE_S3_BUCKET, DALYWAVE_S3_ACCESS_KEY_ID, DALYWAVE_S3_SECRET_ACCESS_KEY
DALYWAVE_STORAGE=fs
# Copies for slow networks and for formats browsers can't play: at most this many GB,
# the least recently played are removed first
DALYWAVE_RENDITIONS_MAX_GB=20

# ─── Deezer catalog: off ───
# true — search the whole Deezer catalog, charts, new releases, similar artists, artist pages;
# your files are matched to it for better covers. Without it everything works on your tags
DALYWAVE_DEEZER=false

# ─── Downloader: off ───
# Downloading recordings from YouTube may break its terms of service — turn it on only for yourself
# and knowing that. To turn on, set all three:
#   COMPOSE_PROFILES=downloader  DALYWAVE_DOWNLOADER=true  DALYWAVE_FETCHER_MODE=remote,server
DALYWAVE_DOWNLOADER=false
# remote — only downloaders connected from computers (Admin → Sources); remote,server — the fetcher container too
DALYWAVE_FETCHER_MODE=remote
# Proxy for the fetcher, e.g. socks5://user:pass@host:1080 (YouTube blocks many datacenter addresses)
FETCHER_PROXY=

# ─── Web Push (optional): notifications in the browser ───
# Generate a key pair straight into .env:
#   docker compose run --rm --no-deps -T api dalywave-api vapid-keys >> .env
# DALYWAVE_VAPID_PUBLIC=
# DALYWAVE_VAPID_PRIVATE=
