{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, e.at, e.actor_user_id, u.name AS \"actor_name?\", e.kind, e.subject, e.payload\n           FROM audit_events e\n           LEFT JOIN users u ON u.id = e.actor_user_id\n           WHERE ($1::uuid IS NULL OR e.id < $1)\n             AND ($3::text IS NULL OR e.kind = $3 OR (right($3, 1) = '.' AND starts_with(e.kind, $3)))\n             AND ($4::uuid IS NULL OR e.actor_user_id = $4)\n           ORDER BY e.id DESC\n           LIMIT $2",
