  "query": "SELECT r.id, r.user_id, u.name, u.username, r.expires_at\n         FROM password_resets r JOIN users u ON u.id = r.user_id\n         WHERE r.token_hash = $1 AND r.used_at IS NULL AND r.expires_at > now()\n         FOR UPDATE OF r",
