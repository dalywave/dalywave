  "query": "SELECT ta.artist_id, count(DISTINCT l.track_id) AS \"n!\" FROM liked_tracks l\n           JOIN track_artists ta ON ta.track_id = l.track_id AND ta.role = 'main'\n           WHERE l.user_id = $1 AND ta.artist_id = ANY($2) GROUP BY ta.artist_id",
