  "query": "SELECT i.id, i.playlist_id, i.track_id, i.position, i.added_at, i.rev\n             FROM playlist_items i JOIN playlists p ON p.id = i.playlist_id\n             WHERE p.user_id = $1 AND i.txid >= $2::text::xid8 AND i.rev > $3 ORDER BY i.rev LIMIT $4",
