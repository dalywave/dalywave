  "query": "SELECT id, kind, position, artist, title, album, status, confidence, track_id, candidates, plays, liked,\n                file_meta\n         FROM import_items\n         WHERE import_id = $1 AND ($2::text IS NULL OR status = $2)\n           AND ($3::int4 IS NULL OR (position, id) > ($3, $4))\n         ORDER BY position, id\n         LIMIT $5",
