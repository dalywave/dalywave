  "query": "SELECT id, user_id, kind, title, body, link, image, items, count, created_at, read_at\n         FROM notifications\n         WHERE user_id = $1 AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n         ORDER BY created_at DESC, id DESC\n         LIMIT $4",
