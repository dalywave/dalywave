  "query": "SELECT dd.id, dd.device_id, dd.kind, dd.ref_id, dd.rev\n             FROM device_downloads dd JOIN devices d ON d.id = dd.device_id\n             WHERE d.user_id = $1 AND dd.txid >= $2::text::xid8 AND dd.rev > $3 ORDER BY dd.rev LIMIT $4",
