  "query": "SELECT i.id, u.name AS user_name, i.surface, i.track_id, i.reason, i.score, i.outcome, i.wave_session_id,\n                i.shown_at\n         FROM recommendation_impressions i JOIN users u ON u.id = i.user_id\n         WHERE i.user_id = $1\n         ORDER BY i.shown_at DESC, i.id DESC\n         LIMIT $2",
