  "query": "SELECT al.id, al.deezer_id, al.title, al.record_type, al.fetched_at, al.release_date\n         FROM artist_releases r JOIN albums al ON al.id = r.album_id\n         WHERE r.artist_id = $1\n         ORDER BY al.release_date DESC NULLS LAST, al.id",
