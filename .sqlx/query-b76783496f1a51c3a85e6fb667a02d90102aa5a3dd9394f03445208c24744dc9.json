  "query": "SELECT al.id, al.title, a.name AS artist, al.upc, al.release_date, s.created_at AS added_at\n           FROM saved_albums s JOIN albums al ON al.id = s.album_id JOIN artists a ON a.id = al.artist_id\n           WHERE s.user_id = $1 ORDER BY s.created_at DESC, al.id",
