  "query": "SELECT id, track_id, started_at, played_ms, end_reason, context_type, context_id\n         FROM play_events\n         WHERE user_id = $1 AND ($2::timestamptz IS NULL OR (started_at, id) < ($2, $3))\n         ORDER BY started_at DESC, id DESC\n         LIMIT $4",
