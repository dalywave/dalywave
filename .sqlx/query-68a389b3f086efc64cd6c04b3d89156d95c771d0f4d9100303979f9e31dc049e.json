{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id, s.user_id, s.device_id, s.auth_method, s.last_seen_at,\n                  u.name AS user_name, u.email, u.avatar_url, u.roles, u.disabled, u.username, s.guest\n           FROM sessions s\n           JOIN users u ON u.id = s.user_id\n           LEFT JOIN devices d ON d.id = s.device_id\n           WHERE s.token_hash = $1 AND s.kind = $2\n             AND s.revoked_at IS NULL AND s.expires_at > now() AND d.revoked_at IS NULL",
